{
  "name": "evex",
  "version": "0.1.0",
  "private": false,
  "author": "TommyBez",
  "license": "MIT",
  "homepage": "https://evex.sh",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "db:generate": "pnpm --filter ./apps/web db:generate",
    "db:migrate": "pnpm --filter ./apps/web db:migrate",
    "db:push": "pnpm --filter ./apps/web db:push",
    "db:studio": "pnpm --filter ./apps/web db:studio",
    "check": "turbo run check",
    "dev": "turbo run dev --filter=./apps/web",
    "email:preview": "pnpm --filter ./apps/web email:preview",
    "fix": "turbo run fix",
    "postinstall": "node packages/agent-registry/scripts/generate-registry.mts",
    "registry:install": "pnpm --dir registry install",
    "start": "pnpm --filter ./apps/web start",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "typecheck:agents": "pnpm --dir registry --recursive run typecheck",
    "video:dev": "pnpm --filter @evex/video dev",
    "video:render": "pnpm --filter @evex/video render",
    "video:render:all": "pnpm --filter @evex/video render:all"
  },
  "devDependencies": {
    "turbo": "^2.8.0"
  },
  "pnpm": {
    "overrides": {
      "hono": "4.12.25"
    }
  }
}
