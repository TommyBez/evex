# Model credential (Vercel AI Gateway API key or OIDC).
AI_GATEWAY_API_KEY=

# Force hubspot or salesforce. When empty, the first complete Connect UID wins.
CRM_PROVIDER=

# Weekly renewal scan cron (UTC on Vercel). Default Monday 08:00.
CHURN_RENEWAL_CRON="0 8 * * 1"

# How many days ahead to include CRM accounts by renewal date.
CHURN_RENEWAL_LOOKAHEAD_DAYS=90

# How many renewal-window accounts to read per scan.
CHURN_RENEWAL_MAX_ACCOUNTS=100

# Append-only JSONL audit log. Use a durable volume in production.
# Stores identifiers, buckets, and field names only — not CRM or Stripe values.
CHURN_RENEWAL_AUDIT_PATH=.data/churn-renewal-audit.jsonl

# Days to keep audit rows. score_renewal_risk purges older rows. Default 90.
CHURN_RENEWAL_AUDIT_RETENTION_DAYS=90

# Slack via Vercel Connect (eve add channel/slack).
# Create a Slack connector and attach triggers to /eve/v1/slack.
# Both values are required for the movers digest.
CHURN_RENEWAL_SLACK_CONNECT_UID=
CHURN_RENEWAL_SLACK_CHANNEL_ID=

# HubSpot via Vercel Connect (vercel connect create hubspot).
# Scopes: crm.objects.companies.read crm.objects.companies.write crm.objects.notes.write
# Company note writes still require draft_save_play after Eve approval.
CHURN_RENEWAL_HUBSPOT_CONNECT_UID=
CHURN_RENEWAL_HUBSPOT_RENEWAL_PROPERTY=renewal_date
CHURN_RENEWAL_HUBSPOT_STRIPE_CUSTOMER_PROPERTY=stripe_customer_id

# Salesforce via Vercel Connect (vercel connect create salesforce).
# Scopes: api refresh_token
CHURN_RENEWAL_SALESFORCE_CONNECT_UID=
CHURN_RENEWAL_SALESFORCE_INSTANCE_URL=
CHURN_RENEWAL_SALESFORCE_RENEWAL_FIELD=Renewal_Date__c
CHURN_RENEWAL_SALESFORCE_STRIPE_CUSTOMER_FIELD=Stripe_Customer_Id__c

# Stripe via Vercel Connect (vercel connect create stripe).
# Scope: read_only. Health lookups are fail-closed and never write Stripe.
CHURN_RENEWAL_STRIPE_CONNECT_UID=
