# Copy to apps/web/.env.local for local development.

DATABASE_URL=postgres://evex:evex@localhost:5432/evex
BETTER_AUTH_URL=http://localhost:3000

# BETTER_AUTH_SECRET=
# Optional GitHub OAuth. Set both or neither.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional. Production email delivery only.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# IndexNow (Bing / Copilot freshness). Unset skips submit and 404s the key
# file. Generate with: openssl rand -hex 32
# Hosted at https://www.evex.sh/{INDEXNOW_KEY}.txt
# INDEXNOW_KEY=
# Authorizes GET/POST /api/indexnow. Vercel Cron sends Authorization: Bearer
# $CRON_SECRET automatically when this is set on the production project.
# CRON_SECRET=
