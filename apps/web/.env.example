# Copy to apps/web/.env.local for local development.

DATABASE_URL=postgres://evex:evex@localhost:5432/evex
BETTER_AUTH_URL=http://localhost:3000

# BETTER_AUTH_SECRET=
# Optional GitHub OAuth. Set both or neither.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional. Production email delivery only.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# IndexNow is not configured via env. The public key file is committed at
# apps/web/public/<key>.txt. Soft Eng submits after merge:
# pnpm --filter ./apps/web indexnow:submit
