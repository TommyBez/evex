{
  "name": "@evex/agent-registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "node scripts/generate-registry.mts",
    "bump-eve": "node scripts/bump-eve.mts",
    "check": "node scripts/generate-registry.mts --check",
    "generate": "node scripts/generate-registry.mts --codeowners",
    "prepare": "node scripts/generate-registry.mts",
    "registry:new": "node scripts/new-agent.mts",
    "registry:scaffold": "node scripts/scaffold-registry-json.mts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --pretty false",
    "typecheck:agents": "node scripts/typecheck-agents.mjs"
  },
  "dependencies": {
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "5.7.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24"
  }
}
